                                const float *cos, const float *sin);
void blt_rope_apply_packed_backward_cuda(float *qkv_data, size_t qkv_stride, size_t head_offset, size_t seq_len,
                                         size_t head_dim, const float *cos, const float *sin);

#ifdef __cplusplus
}
